{
  "name": "revo-formatter",
  "displayName": "Revofmt Code Formatter",
  "description": "Format Revo documents through the preservation-checked revofmt CLI.",
  "version": "0.2.0",
  "publisher": "w0x7y",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/w0x7y/revofmt-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:revo"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Revo file recognition is available; formatting executes the configured binary and requires workspace trust.",
      "restrictedConfigurations": [
        "revofmt.executable"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "revo",
        "aliases": [
          "Revo",
          "revo"
        ],
        "extensions": [
          ".rv",
          ".revo"
        ]
      }
    ],
    "configuration": {
      "title": "Revofmt Code Formatter",
      "properties": {
        "revofmt.executable": {
          "type": "string",
          "default": "revofmt",
          "scope": "machine-overridable",
          "description": "Executable name on PATH or absolute path on the extension host. Executes only in trusted workspaces; no shell expansion or arguments."
        },
        "revofmt.indentWidth": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "scope": "resource",
          "description": "Formatter indentation width, independent of editor tab size. A project revofmt.toml takes precedence."
        },
        "revofmt.indentStyle": {
          "type": "string",
          "enum": [
            "space",
            "tab"
          ],
          "default": "space",
          "scope": "resource",
          "description": "Indent with spaces or one tab per level. A project revofmt.toml takes precedence."
        },
        "revofmt.lineWidth": {
          "type": "integer",
          "default": 80,
          "minimum": 20,
          "maximum": 240,
          "scope": "resource",
          "description": "Formatter soft line-width target. A project revofmt.toml takes precedence."
        },
        "revofmt.maxBlankLines": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 8,
          "scope": "resource",
          "description": "Maximum consecutive blank lines to keep. A project revofmt.toml takes precedence."
        },
        "revofmt.timeoutMs": {
          "type": "integer",
          "default": 5000,
          "minimum": 1,
          "maximum": 2147483647,
          "scope": "resource",
          "description": "Maximum duration of one formatting subprocess, in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:host": "node tests/host/launch.js",
    "package": "vsce package --no-dependencies --out revo-formatter-0.2.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "homepage": "https://github.com/w0x7y/revofmt-vscode#readme",
  "bugs": {
    "url": "https://github.com/w0x7y/revofmt-vscode/issues"
  },
  "icon": "images/icon.png"
}
